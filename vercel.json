{
  "version": 2,
  "installCommand": "npm install && npm install --prefix server",
  "buildCommand": "npm install --prefix client && npm run --prefix client build",
  "outputDirectory": "client/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)",     "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "server/db/schema.sql"
    }
  }
}
